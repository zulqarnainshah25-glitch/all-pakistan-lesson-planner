<%- include('partials/header') %>

<style>
    /* Form Controls Text Visibility Fix (Inputs, Selects, and Placeholders) */
  input.form-control, 
  select.form-control, 
  select.form-control option {
      color: #1a202c !important; /* Dark text (Black/Dark Gray) */
      background-color: #ffffff !important; /* White background */
  }
  
  input.form-control::placeholder {
      color: #64748b !important; /* Dark gray placeholder (taake hints saaf nazar aayein) */
  }
  /* Dropdown (Select Box) Text Visibility Fix */
  select.form-control,
  select.form-control option {
    color: #1a202c !important; /* Dark gray/black text */
    background-color: #ffffff !important; /* White background */
  }
  /* Salary Calculator Dynamic Text Color Fix */
  .post-body,
  .post-body div,
  .post-body span,
  .post-body p,
  .post-body label,
  .post-body td,
  .post-body th,
  .post-body li {
    color: var(--text-main) !important;
  }
  .post-body small,
  .post-body [style*="color"] {
    color: var(--text-main) !important;
  }
  .post-body h1,
  .post-body h2,
  .post-body h3,
  .post-body h4,
  .post-body h5,
  .post-body h6 {
    color: var(--primary) !important;
  }

  :root {
    --primary: #0f5e30;
    --primary-light: #1a8a48;
    --card-bg: #ffffff;
    --text-dark: #2c3e50;
    --text-muted: #6c757d;
    --border-color: #e0e0e0;
    --error: #dc3545;
  }

  .calc-container {
    max-width: 650px;
    margin: 40px auto;
    background: var(--card-bg);
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    animation: fadeIn 0.4s ease-out;
  }
  .calc-header {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    padding: 20px;
    text-align: center;
  }
  .calc-header h2 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 4px;
    color: white !important;
  }
  .calc-header p {
    font-size: 13px;
    opacity: 0.9;
  }
  .content {
    padding: 20px;
  }
  .form-group {
    margin-bottom: 16px;
  }
  .form-group label {
    display: block;
    margin-bottom: 6px;
    font-weight: 600;
    color: var(--text-dark);
    font-size: 13px;
  }
  .form-control {
    width: 100%;
    padding: 10px 14px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 15px;
    background-color: #fafafa;
  }
  .form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(26, 138, 72, 0.1);
    background-color: #fff;
  }
  .form-control:disabled {
    background-color: #e9ecef;
    cursor: not-allowed;
  }
  .btn-container {
    display: flex;
    gap: 10px;
    margin-top: 24px;
  }
  .btn-calc {
    flex: 1;
    padding: 12px;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
  }
  .btn-primary {
    background-color: var(--primary);
    color: white;
  }
  .btn-secondary {
    background-color: #f1f1f1;
    color: var(--text-dark);
  }
  #error-msg {
    display: none;
    color: var(--error);
    font-size: 13px;
    margin-bottom: 15px;
    padding: 10px;
    background-color: #f8d7da;
    border-radius: 6px;
    text-align: center;
  }
  .results {
    display: none;
    margin-top: 24px;
    border-top: 2px dashed var(--border-color);
    padding-top: 20px;
    animation: slideDown 0.3s ease-out;
  }
  .section-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--primary);
    margin: 16px 0 8px 0;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--border-color);
    text-transform: uppercase;
  }
  .result-table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 12px;
    font-size: 14px;
  }
  .result-table td {
    padding: 8px 4px;
    border-bottom: 1px solid #f0f0f0;
  }
  .result-label {
    color: var(--text-dark);
    font-weight: 500;
  }
  .result-value {
    font-weight: 600;
    text-align: right;
    color: var(--text-dark);
  }
  .result-subtext {
    font-size: 11px;
    color: var(--text-muted);
    display: block;
  }
  .summary-card {
    padding: 12px 16px;
    border-radius: 8px;
    margin-top: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
    font-size: 15px;
  }
  .card-blue {
    background-color: #e8f4fd;
    border: 1px solid #b8daff;
    color: #004085;
  }
  .card-red {
    background-color: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
  }
  .card-dark-green {
    background-color: #d1e7dd;
    border: 1px solid #badbcc;
    color: #0f5132;
  }
  .card-vibrant-green {
    background-color: #28a745;
    color: #ffffff;
    border: none;
    box-shadow: 0 4px 12px rgba(40, 167, 69, 0.3);
    margin-top: 16px;
    padding: 16px;
    border-radius: 10px;
  }
  .info-section {
    margin-top: 30px;
    padding: 20px 0;
    border-top: 1px solid var(--border-color);
  }
  .info-section h3 {
    color: var(--primary);
    font-size: 18px;
    margin-bottom: 12px;
  }
  .info-section p,
  .info-section li {
    color: var(--text-dark);
    font-size: 14px;
    margin-bottom: 8px;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div class="container mx-auto px-6 py-8 flex-grow">
  <div class="calc-container">
    <div class="calc-header">
      <h2>Government of Sindh</h2>
      <p>
        Salary &amp; Sindh Government Salary Calculator 2026 by Sayed Zulqarnain
        Shah
      </p>
    </div>

    <div class="content">
      <p
        style="
          color: var(--text-dark);
          font-size: 14px;
          line-height: 1.6;
          margin-bottom: 20px;
          text-align: left;
        "
      >
        Welcome to the official
        <strong>sindh government salary calculator 2026</strong> on ALLFORU.
        Whether you are looking for an accurate
        <strong>bps 14 salary calculator sindh</strong> to check your
        post-budget allowances, or you simply want to estimate your
        <strong>sindh school teacher salary slip online</strong>, this tool is
        designed for you. Created specifically to assist our teaching community
        across all districts, from Ghotki to Karachi, it provides exact
        calculations for BPS-01 to BPS-22 employees instantly.
      </p>

      <div id="error-msg"></div>

      <form id="calculator-form">
        <div class="form-group">
          <label for="emp-name">Employee Name (Optional)</label>
          <input
            class="form-control"
            id="emp-name"
            placeholder="Enter Employee Name"
            type="text"
          />
        </div>

        <div class="form-group">
          <label for="bps">Basic Pay Scale (BPS) *</label>
          <select class="form-control" id="bps" required="">
            <option disabled="" selected="" value="">
              Select BPS (01 - 22)
            </option>
          </select>
        </div>

        <div class="form-group">
          <label for="stage">Pay Stage / Increments *</label>
          <select class="form-control" disabled="" id="stage" required="">
            <option disabled="" selected="" value="">
              First select BPS above
            </option>
          </select>
        </div>

        <div class="form-group">
          <label for="basic-pay"
            >Current Running Basic Pay (2022 Scale) *</label
          >
          <input
            class="form-control"
            id="basic-pay"
            placeholder="Auto-filled based on stage"
            required=""
            type="number"
          />
        </div>

        <div class="btn-container">
          <button class="btn-calc btn-primary" type="submit">
            Calculate Complete Salary
          </button>
          <button
            class="btn-calc btn-secondary"
            onclick="resetForm()"
            type="button"
          >
            Reset
          </button>
        </div>
      </form>

      <div class="results" id="results-section">
        <div style="margin-bottom: 12px; text-align: center">
          <h3 id="res-emp-title" style="color: var(--primary); font-size: 18px">
            Salary Breakdown
          </h3>
          <span
            id="res-bps-detail"
            style="color: var(--text-muted); font-size: 12px"
            >-</span
          >
        </div>

        <div class="section-title">1. Pay &amp; Allowances (Monthly)</div>
        <table class="result-table">
          <tr>
            <td>
              <span class="result-label">Revised Basic Pay 2026</span
              ><span class="result-subtext">Merged Adhoc 2022 &amp; 2025</span>
            </td>
            <td class="result-value" id="res-revised-bp">-</td>
          </tr>
          <tr>
            <td>
              <span class="result-label">House Rent Allowance</span
              ><span class="result-subtext">Frozen Standard Rate</span>
            </td>
            <td class="result-value" id="res-house-rent">-</td>
          </tr>
          <tr>
            <td>
