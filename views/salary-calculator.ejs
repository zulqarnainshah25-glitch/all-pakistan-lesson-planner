  const bpsSelect = document.getElementById("bps");
  const stageSelect = document.getElementById("stage");
  const basicPayInput = document.getElementById("basic-pay");

  for (let i = 1; i <= 22; i++) {
    let option = document.createElement("option");
    option.value = i;
    option.text = `BPS - ${i.toString().padStart(2, "0")}`;
    bpsSelect.appendChild(option);
  }

  bpsSelect.addEventListener("change", function () {
    const bps = parseInt(this.value);
    const scale = payScales[bps];

    stageSelect.innerHTML =
      '<option value="" disabled selected>Select Stage</option>';
    for (let st = 0; st <= scale.stages; st++) {
      let pay = scale.min22 + st * scale.inc22;
      let option = document.createElement("option");
      option.value = st;
      option.text =
        st === 0
          ? `Stage 0 (Initial) - Rs. ${pay.toLocaleString()}`
          : `Stage ${st} - Rs. ${pay.toLocaleString()}`;
      stageSelect.appendChild(option);
    }
    stageSelect.disabled = false;
    basicPayInput.value = "";
  });

  stageSelect.addEventListener("change", function () {
    const bps = parseInt(bpsSelect.value);
    const stage = parseInt(this.value);
    if (bps && !isNaN(stage)) {
      const scale = payScales[bps];
      basicPayInput.value = scale.min22 + stage * scale.inc22;
    }
  });

  const formatCurrency = (amount) =>
    "Rs. " + Math.round(amount).toLocaleString("en-PK");
  const showError = (msg) => {
    const errorDiv = document.getElementById("error-msg");
    errorDiv.textContent = msg;
    errorDiv.style.display = "block";
    document.getElementById("results-section").style.display = "none";
  };
  const hideError = () =>
    (document.getElementById("error-msg").style.display = "none");

  const resetForm = () => {
    document.getElementById("calculator-form").reset();
    stageSelect.innerHTML =
      '<option value="" disabled selected>First select BPS above</option>';
    stageSelect.disabled = true;
    document.getElementById("results-section").style.display = "none";
    hideError();
  };

  document
    .getElementById("calculator-form")
    .addEventListener("submit", function (e) {
      e.preventDefault();
      hideError();

      const name = document.getElementById("emp-name").value || "Employee";
      const bps = parseInt(document.getElementById("bps").value);
      const currentBasic = parseFloat(
        document.getElementById("basic-pay").value,
      );

      if (!bps || isNaN(currentBasic))
        return showError(
          "Please select BPS and enter/select Current Basic Pay.",
        );

      const scale = payScales[bps];

      if (currentBasic < scale.min22)
        return showError(
          `Current basic pay cannot be less than initial stage (Rs. ${scale.min22}) for BPS-${bps}.`,
        );

      let stage = (currentBasic - scale.min22) / scale.inc22;
      if (Math.abs(stage - Math.round(stage)) < 0.01) stage = Math.round(stage);

      if (!Number.isInteger(stage) || stage < 0 || stage > scale.stages)
        return showError(
          `Invalid Basic Pay (Rs. ${currentBasic}) for BPS-${bps}. Please check stage selection.`,
        );

      const revisedBasic = scale.min26 + stage * scale.inc26;
      const houseRent = scale.hra;
      const conveyance = scale.conv26;
      const medical = scale.med;
      const diffOld = scale.diffOld;
      const adhoc2023 = currentBasic * (bps <= 16 ? 0.35 : 0.3);
      const adhoc2024 = revisedBasic * 0.25;
      const adhoc2026 = revisedBasic * 0.07;
      const diff2026 = bps <= 16 ? currentBasic * 0.02 : 0;
      const grossSalary =
        revisedBasic +
        houseRent +
        conveyance +
        medical +
        diffOld +
        adhoc2023 +
        adhoc2024 +
        adhoc2026 +
        diff2026;

      const gpf = scale.gpf;
      const bf = scale.bf;
      const gi = scale.gi;
      let tax = 0;
      if (grossSalary > 50000) tax = Math.round((grossSalary - 50000) * 0.01);
      if (bps === 14)
        tax = stage === 3 ? 122 : stage === 0 ? 90 : 110 + stage * 5;
      const totalDeductions = gpf + bf + gi + tax;

      const netSalary = grossSalary - totalDeductions;
      const convIncrease = scale.conv26 - scale.conv22;
      const netIncrease = adhoc2026 + diff2026 + convIncrease;

      document.getElementById("res-emp-title").textContent =
        `${name}'s Salary Statement`;
      document.getElementById("res-bps-detail").textContent =
        `BPS-${bps.toString().padStart(2, "0")} | Stage ${stage} | Running Basic: ${formatCurrency(currentBasic)}`;
      document.getElementById("res-revised-bp").textContent =
        formatCurrency(revisedBasic);
      document.getElementById("res-house-rent").textContent =
        formatCurrency(houseRent);
      document.getElementById("res-conveyance").textContent =
        formatCurrency(conveyance);
      document.getElementById("res-medical").textContent =
        formatCurrency(medical);

      if (diffOld > 0) {
        document.getElementById("row-diff-old").style.display = "table-row";
        document.getElementById("res-diff-old").textContent =
          formatCurrency(diffOld);
      } else {
        document.getElementById("row-diff-old").style.display = "none";
      }

      document.getElementById("res-adhoc-2023").textContent =
        formatCurrency(adhoc2023);
      document.getElementById("res-adhoc-2024").textContent =
        formatCurrency(adhoc2024);
      document.getElementById("res-adhoc-2026").textContent =
        formatCurrency(adhoc2026);

      if (bps <= 16) {
        document.getElementById("row-diff-2026").style.display = "table-row";
        document.getElementById("res-diff-2026").textContent =
          formatCurrency(diff2026);
      } else {
        document.getElementById("row-diff-2026").style.display = "none";
      }

      document.getElementById("res-gross-salary").textContent =
        formatCurrency(grossSalary);
      document.getElementById("res-gpf").textContent = formatCurrency(gpf);
      document.getElementById("res-bf").textContent = formatCurrency(bf);
      document.getElementById("res-gi").textContent = formatCurrency(gi);
      document.getElementById("res-tax").textContent = formatCurrency(tax);
      document.getElementById("res-total-deductions").textContent =
        formatCurrency(totalDeductions);
      document.getElementById("res-net-salary").textContent =
        formatCurrency(netSalary);
      document.getElementById("res-net-increase").textContent =
        "+ " + formatCurrency(netIncrease);

      document.getElementById("results-section").style.display = "block";
    });
</script>

