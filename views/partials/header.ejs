<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Allforu Education Portal</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <script>
      tailwind.config = { darkMode: "class" };
    </script>
    <style>
      /* 1. Header (Navbar) Ka Background Color */
      #nav-bar {
        background: #2d2e3f !important; /* Yahan apna marzi ka color code dalein */
        border-bottom: 2px solid #1f2937 !important; /* Niche wali line ka color */
      }

      /* 2. Logo (Allforu) Ka Text Color */
      #nav-logo {
        color: #4189ee !important; /* Logo ka rang */
      }

      /* 3. Menu Links (Home, About, etc.) Ka Text Color */
      .nav-item {
        color: #e5e7eb !important; /* Aam halat mein text ka rang */
      }

      /* 4. Menu Links par jab mouse aaye (Hover Effect) */
      .nav-item:hover {
        color: #4ade80 !important; /* Mouse upar aane par text ka rang */
      }
    </style>
  </head>
  <body
    class="bg-gray-900 text-gray-100 font-sans min-h-screen flex flex-col transition-colors duration-300"
    id="body-layout"
  >
    <!-- Top Navigation Bar -->
    <nav
      id="nav-bar"
      class="bg-gradient-to-r from-blue-950 via-indigo-900 to-blue-900 border-b border-blue-800/40 sticky top-0 z-50 shadow-xl transition-colors duration-300"
    >
      <div
        class="container mx-auto px-6 py-4 flex justify-between items-center flex-wrap gap-4"
      >
        <a
          href="/"
          id="nav-logo"
          class="text-2xl font-black tracking-wider text-cyan-400 flex items-center gap-2 transition-colors"
        >
          Allforu
          <span
            class="text-xs bg-cyan-500 text-gray-900 px-2 py-0.5 rounded-full font-bold"
            >Portal</span
          >
        </a>
        <div
          id="nav-links"
          class="space-x-5 text-sm font-medium hidden lg:flex items-center"
        >
          <a
            href="/"
            class="nav-item text-cyan-400 hover:text-cyan-300 font-semibold transition"
            >Home</a
          >
          <a
            href="/lesson-planner"
            class="nav-item text-gray-200 hover:text-cyan-400 transition"
            >Lesson Plans</a
          >
          <a
            href="/salary-calculator"
            class="nav-item text-gray-200 hover:text-cyan-400 transition"
            >Salary Calculator</a
          >

          <a
            href="/about"
            class="nav-item text-gray-200 hover:text-cyan-400 transition"
            >About</a
          >
          <a
            href="/contact"
            class="nav-item text-gray-200 hover:text-cyan-400 transition"
            >Contact</a
          >
        </div>
        <div class="flex items-center space-x-3">
          <div class="relative">
            <input
              type="text"
              id="search-box"
              placeholder="Search tools..."
              onkeyup="filterTools()"
              class="bg-blue-950/80 text-gray-200 text-xs px-3 py-2 pl-8 rounded-lg border border-blue-800/50 focus:outline-none focus:border-cyan-400 w-36 sm:w-48 transition"
            />
            <span class="absolute left-2.5 top-2 text-gray-400 text-xs"
              >🔍</span
            >
          </div>
          <button
            onclick="toggleDarkMode()"
            id="theme-toggle-btn"
            class="bg-blue-900 hover:bg-blue-800 text-cyan-400 border border-blue-700/50 p-2 rounded-lg text-sm transition shadow"
            title="Toggle Dark/Light Mode"
          >
            🌙
          </button>
        </div>
      </div>
    </nav>
  </body>
</html>
